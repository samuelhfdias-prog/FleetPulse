.env.example:
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
CORS_ORIGIN=http://localhost:4200
DATABASE_PATH=data/momesso.sqlite
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false
# Obrigatório em produção: use ao menos 32 caracteres aleatórios.
JWT_SECRET=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres
JWT_EXPIRATION=3600
ENABLE_DEMO_SEED=true
# Use apenas no ambiente local de demonstração.
DEMO_ADMIN_PASSWORD=123456
DEMO_USER_PASSWORD=123456
